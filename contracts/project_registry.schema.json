{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assembly-line.local/contracts/project_registry.schema.json",
  "title": "ProjectRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "default_project_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project_ref"
      }
    }
  },
  "$defs": {
    "project_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "workspace_path",
        "status",
        "default_view"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "workspace_path": {
          "type": "string",
          "pattern": "^projects/[a-z0-9][a-z0-9\\-]*/project_workspace\\.json$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "paused",
            "archived"
          ]
        },
        "default_view": {
          "type": "string",
          "enum": [
            "overview",
            "planning-runs",
            "task-batches",
            "dispatch",
            "assignments",
            "verification"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
